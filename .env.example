# ─── Telegram ────────────────────────────────────────────
TELEGRAM_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=generate-a-random-32-char-string-here
ALLOWED_CHAT_IDS=123456789,987654321

# ─── LLM Provider ────────────────────────────────────────
# Set ONE of the providers below. Options:
#   anthropic | openai | openrouter | gemini | opencode | zen
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30.0

# ── Anthropic (Claude) ────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ── OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Google Gemini ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── OpenCode-Go ───────────────────────────────────────────
OPENCODE_BASE_URL=http://localhost:8080/v1
OPENCODE_API_KEY=

# ── Zen ───────────────────────────────────────────────────
ZEN_BASE_URL=http://localhost:3000/v1
ZEN_API_KEY=

# ─── Brave Search ────────────────────────────────────────
BRAVE_API_KEY=your-brave-search-api-key-here
BRAVE_SEARCH_RESULTS=5

# ─── Script Runner ───────────────────────────────────────
SCRIPTS_DIR=scripts
SCRIPT_TIMEOUT=10

# ─── Database ────────────────────────────────────────────
DB_PATH=data/assistant.db

# ─── Summarizer ──────────────────────────────────────────
SUMMARIZE_EVERY_N_MESSAGES=50
SUMMARIZE_MAX_CHARS=8000
