# ─── Telegram ────────────────────────────────────────────
TELEGRAM_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=generate-a-random-32-char-string-here
ALLOWED_CHAT_IDS=123456789,987654321

# ─── LLM Provider ────────────────────────────────────────
# Default: Gemini 2.5 Flash (free tier — 1,500 req/day, no credit card).
# Options: anthropic | openai | openrouter | gemini | opencode | zen
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30.0

# ── Google Gemini (recommended — free tier) ───────────────
# Get an API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Anthropic (Claude) ────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ── OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── OpenCode-Go ───────────────────────────────────────────
OPENCODE_BASE_URL=http://localhost:8080/v1
OPENCODE_API_KEY=

# ── Zen ───────────────────────────────────────────────────
ZEN_BASE_URL=http://localhost:3000/v1
ZEN_API_KEY=

# ─── Web Search ─────────────────────────────────────────
# DuckDuckGo is the default (free, no API key).
# Switch to Brave by adding BRAVE_API_KEY.
SEARCH_RESULTS=5

# ─── Script Runner ───────────────────────────────────────
SCRIPTS_DIR=scripts
SCRIPT_TIMEOUT=10

# ─── Database ────────────────────────────────────────────
DB_PATH=data/assistant.db

# ─── AI Personality ──────────────────────────────────────
# Tone injected into all LLM responses
AI_PERSONALITY=friendly, clear, concise, fun, light sarcasm

# ─── PC Power Control (optional — Raspberry Pi with GPIO relay) ──
# IP address of the PC to control via ping-pc.sh
PC_IP_ADDRESS=192.168.1.100

# ─── Summarizer ──────────────────────────────────────────
SUMMARIZE_EVERY_N_MESSAGES=50
SUMMARIZE_MAX_CHARS=8000
