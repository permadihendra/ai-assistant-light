[Unit]
Description=ai-assistant-light
After=network.target

# ═══════════════════════════════════════════════════════════════
# PRODUCTION MODE — use with a permanent Cloudflare Named Tunnel
# ═══════════════════════════════════════════════════════════════
#
# Prerequisites:
#   1. cloudflared tunnel login
#   2. cloudflared tunnel create ai-assistant
#   3. Route DNS, create config.yml with service: localhost:8123
#   4. sudo cloudflared service install  (runs cloudflared as daemon)
#
# This service ONLY runs uvicorn. Tunnel runs separately via
# cloudflared systemd service.
#
# ═══════════════════════════════════════════════════════════════
# DEV MODE (Quick Tunnel, no domain needed):
#   ./scripts/start-bot.sh
# This handles: cloudflared tunnel → URL → webhook → uvicorn
# ═══════════════════════════════════════════════════════════════

[Service]
User=pi
WorkingDirectory=/home/pi/ai-assistant-light
EnvironmentFile=/home/pi/ai-assistant-light/.env
ExecStart=/home/pi/ai-assistant-light/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8123 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
MemoryMax=512M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
